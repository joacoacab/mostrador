PORT=3000
REDIS_URL=redis://localhost:6379

# waha | meta -- meta todavía no está implementado (tarea 30)
WHATSAPP_PROVIDER=waha

# Adapter WAHA (dev/pruebas, ver docker-compose.yml). WAHA_API_KEY debe
# coincidir con el valor que use el container de waha.
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=changeme
WAHA_SESSION=default

# Solo hace falta en WSL2 + Docker Desktop si host.docker.internal no llega
# al proceso corriendo en la distro -- ver docker-compose.yml. Poner la IP
# que devuelve `hostname -I` (o `ip addr show eth0`) dentro de la distro.
# WAHA_HOOK_HOST=172.x.x.x

# Order Core (tarea 32). El token se genera desde el admin de Django --
# ver tenants.BotToken, tarea 25.
ORDER_CORE_URL=http://localhost:8000
ORDER_CORE_BOT_TOKEN=

# Agente (tarea 33). Key propia del bot, separada de la sesión de Claude
# Code. claude-haiku-4-5 por default -- las 4 tools son simples, no hace
# falta un modelo más caro (ver docs/tasks.md tarea 33 para la decisión).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
